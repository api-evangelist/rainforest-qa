            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/folders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              },
              {
                "name": "title",
                "value": "",
                "type": "query",
                "description": "Filter by title (case-insensitive)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by type"
              }
            ]
          },
          "docs": "List folders"
        },
        {
          "info": {
            "name": "Create a new folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.rainforestqa.com/api/1/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new folder"
        },
        {
          "info": {
            "name": "Get a folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "without_tests",
                "value": "",
                "type": "query",
                "description": "Return folder data without tests and test_count"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              }
            ]
          },
          "docs": "Get folder details including a paginated list of tests"
        },
        {
          "info": {
            "name": "Update a folder",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a folder"
        },
        {
          "info": {
            "name": "Delete a folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/folders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a folder"
        }
      ]
