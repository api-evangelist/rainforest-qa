{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rainforest callback tags API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CLIENT_TOKEN",
      "value": "{{CLIENT_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/tags",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by name (case-insensitive)"
              }
            ]
          },
          "docs": "List tags"
        },
        {
          "info": {
            "name": "Rename a tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/tags/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Tag name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rename a tag"
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/tags/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Tag name"
              }
            ]
          },
          "docs": "Remove a tag from all tests"
        }
      ]
    }
  ],
  "bundled": true
}