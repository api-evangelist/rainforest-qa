{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rainforest callback users API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CLIENT_TOKEN",
      "value": "{{CLIENT_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/users",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by name (case-insensitive)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Invite a user to authenticated account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.rainforestqa.com/api/1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite a user to authenticated account"
        },
        {
          "info": {
            "name": "List all users with and without permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/users/all",
            "params": [
              {
                "name": "slim",
                "value": "",
                "type": "query",
                "description": "If true, returns less data in order to reduce latency and response size"
              }
            ]
          },
          "docs": "List all users with and without permissions"
        },
        {
          "info": {
            "name": "Update user permissisons",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/users/permissions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update user permissisons"
        },
        {
          "info": {
            "name": "Reset the password for an email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.rainforestqa.com/api/1/users/reset_password",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reset the password for an email"
        },
        {
          "info": {
            "name": "Get a user's account information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "A user ID"
              }
            ]
          },
          "docs": "Get a user's account information"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "A user ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Delete a user account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "A user ID"
              },
              {
                "name": "delete_linked",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete a user account"
        },
        {
          "info": {
            "name": "Rotate a user's API token",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/users/:user_id/regenerate_api_token",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "A user ID"
              }
            ]
          },
          "docs": "Rotate a user's API token"
        },
        {
          "info": {
            "name": "Delete a user's Omniauth provider profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/users/:user_id/omniauth/:provider",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "A user ID"
              },
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "A provider name"
              }
            ]
          },
          "docs": "Delete a user's Omniauth provider profile"
        }
      ]
    }
  ],
  "bundled": true
}