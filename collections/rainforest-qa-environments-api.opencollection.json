{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rainforest callback environments API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CLIENT_TOKEN",
      "value": "{{CLIENT_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/environments",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by name (case-insensitive)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              }
            ]
          },
          "docs": "List environments"
        },
        {
          "info": {
            "name": "Create a new environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.rainforestqa.com/api/1/environments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new environment and corresponding site-environments for each site as well"
        },
        {
          "info": {
            "name": "Get an environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/environments/:environment_id",
            "params": [
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "An environment ID"
              }
            ]
          },
          "docs": "Get an environment"
        },
        {
          "info": {
            "name": "Update an environment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/environments/:environment_id",
            "params": [
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "An environment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an environment"
        },
        {
          "info": {
            "name": "Delete an environment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/environments/:environment_id",
            "params": [
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "An environment ID"
              }
            ]
          },
          "docs": "Delete an environment and its associated site-environments"
        }
      ]
    }
  ],
  "bundled": true
}