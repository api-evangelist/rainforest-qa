{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rainforest callback sites API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "CLIENT_TOKEN",
      "value": "{{CLIENT_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "sites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a site",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/sites/:site_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path",
                "description": "A site ID"
              }
            ]
          },
          "docs": "Get a site"
        },
        {
          "info": {
            "name": "Update a site",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/sites/:site_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path",
                "description": "A site ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a site"
        },
        {
          "info": {
            "name": "Delete a site",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.rainforestqa.com/api/1/sites/:site_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path",
                "description": "A site ID"
              }
            ]
          },
          "docs": "Delete a site and its associated site-environments"
        },
        {
          "info": {
            "name": "List sites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.rainforestqa.com/api/1/sites",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by name (case-insensitive)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page of results to display"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page; maximum: 100"
              }
            ]
          },
          "docs": "List sites"
        },
        {
          "info": {
            "name": "Create a new site",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.rainforestqa.com/api/1/sites",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new site - creates corresponding site-environments for each environment as well"
        }
      ]
    }
  ],
  "bundled": true
}