                "name": "id",
                "value": "",
                "type": "path",
                "description": "Connection ID"
              }
            ]
          },
          "docs": "Get connection status"
        },
        {
          "info": {
            "name": "Regenerate API token",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.rainforestqa.com/api/1/connections/:id/regenerate_api_token",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Connection ID"
              }
            ]
